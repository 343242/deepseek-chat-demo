# =============================================================================
# Smart RAG 环境变量样例
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env  然后填入实际值（务必把所有 ⚠️ 必填项都改掉）
# .env 已被 .gitignore 排除，绝不会进 git；切勿把真实密钥贴到任何代码/文档里。
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# [部署] 时区（JVM TZ 与 API 输出展示时区从同一变量派生，设计文档 §5）
# ─────────────────────────────────────────────────────────────────────────────
APP_TIME_ZONE=Asia/Shanghai

# ─────────────────────────────────────────────────────────────────────────────
# [部署] 反向代理 / 证书（docker-compose.prod.yml + scripts/init-ssl.sh 读取）
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ 必填：指向本服务器的域名（A 记录需已生效）。证书 CN、nginx server_name 都用它
SERVER_NAME=smart-rag.example.com
# ⚠️ 必填：Let's Encrypt 注册邮箱（证书过期提醒）
CERTBOT_EMAIL=you@example.com
# ⚠️ 必填：前端访问地址（多个用逗号分隔）。CORS 不允许 *（因 allowCredentials=true）
CORS_ALLOWED_ORIGINS=https://smart-rag.example.com

# ─────────────────────────────────────────────────────────────────────────────
# [部署] Spring profile（docker-compose.prod.yml 已硬编码 stable,prod，此处仅文档）
# ─────────────────────────────────────────────────────────────────────────────
# 生产部署时由 compose 注入 SPRING_PROFILES_ACTIVE=stable,prod，无需在此设置。
# 单独运行 JAR 时（非容器化）：export SPRING_PROFILES_ACTIVE=stable,prod

# ─────────────────────────────────────────────────────────────────────────────
# [必填·敏感] PostgreSQL（docker-compose 初始化 + 应用数据源）
# ─────────────────────────────────────────────────────────────────────────────
# 仅 docker-compose 在首次创建数据库时读取此变量，应用不读（应用读 DB_NAME）
POSTGRES_DB=smart_rag
POSTGRES_USER=smart_rag
# ⚠️ 必填：生产必须改成强密码（≥16 位，含大小写+数字+符号）
POSTGRES_PASSWORD=replace_me_with_strong_password
PG_PORT=5432

# 应用实际读取的 DB 连接参数（compose 内部网络下用 service 名 postgres）
DB_HOST=postgres
DB_NAME=smart_rag

# ─────────────────────────────────────────────────────────────────────────────
# [必填·敏感] Redis（限流/ChatMemory/幂等去重/token 黑名单）
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# ⚠️ 必填：生产必须设强密码（compose 中 redis 启动时也用此值）
REDIS_PASSWORD=replace_me_with_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# [必填·敏感] JWT 签名密钥
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ 必填：≥32 字符的随机串。生产环境 JwtTokenProvider 会拒绝已知默认值。
# 生成方式（任选其一）：
#   openssl rand -base64 48
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_at_least_32_random_chars_long
# 单位：秒（默认 access 15min / refresh 24h，一般无需调整）
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=86400

# ─────────────────────────────────────────────────────────────────────────────
# [必填·敏感] LLM Provider API Key
# ─────────────────────────────────────────────────────────────────────────────
# 至少配置一个 provider 的 key（默认主用 bailian/dashscope）
# ⚠️ 阿里云百炼：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-replace_me
# ⚠️ DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-replace_me
# ⚠️ 智谱：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=replace_me
# ⚠️ MiniMax：https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=sk-replace_me

# ─────────────────────────────────────────────────────────────────────────────
# [可选·敏感] BYOK 加密 master key（仅在 LLM_BYOK_ENABLED=true 时必填）
# ─────────────────────────────────────────────────────────────────────────────
# 启用 BYOK 后，用户在 UI 填的 LLM API key 会用此 master key AES/GCM 加密入库。
# 缺失或为空 → ApiKeyCipher 构造时 fail-fast，应用启动失败。
# 生成方式：openssl rand -base64 32  （必须 base64 编码的 32 字节）
LLM_BYOK_ENABLED=false
SECURITY_CRYPTO_MASTER_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# [可选·敏感] MinIO（compose 中已就绪，应用通过容器名访问）
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ 仅 docker-compose 初始化 MinIO 时读取，应用 stable profile 不读 spring.minio.*
# 生产必须改默认账号密码
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_me_with_strong_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 应用访问 MinIO 的 endpoint（compose 内部网络）
MINIO_ENDPOINT=http://minio:9000
# 浏览器可达的 MinIO 地址（presigned URL 签发用，Host 参与签名）；缺省回退 MINIO_ENDPOINT（dev 同址零配置）
MINIO_EXTERNAL_ENDPOINT=
# 浏览器直传 MinIO 的 CORS 白名单（服务级全局；bucket 级 CORS API 本镜像 501 不可用）。
# dev 缺省 * 开箱即用；生产不提供 * 缺省（fail-closed），白名单与后端 CORS_ALLOWED_ORIGINS 同源维护。
# 另见 docs/design/presigned-direct-upload.md「MinIO CORS」节
MINIO_API_CORS_ALLOW_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────────
# [可选] 功能开关
# ─────────────────────────────────────────────────────────────────────────────
# MCP 客户端：默认开启。关掉后 Agent 模式失去 MCP 工具调用，但不影响 Chat/RAG 主链路
MCP_ENABLED=true
# 代码执行沙箱（需要宿主 docker.sock 挂载，单机部署可不挂载 → 自动降级禁用）
SANDBOX_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# [可选] Snowflake ID（多实例部署时每个实例必须唯一，单机可保持默认）
# ─────────────────────────────────────────────────────────────────────────────
# SNOWFLAKE_EPOCH=2026-01-01T00:00:00+08:00
# SNOWFLAKE_DATACENTER_ID=0
# SNOWFLAKE_WORKER_ID=0
